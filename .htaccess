RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# Serve static files directly from msmc/staticfiles
RewriteRule ^static/(.*)$ /home/CPANEL_USERNAME/msmc/staticfiles/$1 [L]
RewriteRule ^media/(.*)$ /home/CPANEL_USERNAME/msmc/media/$1 [L]

# Prevent access to sensitive files
<FilesMatch "\.(env|ini|log|sh|sql|json|lock)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Disable directory browsing
Options -Indexes

# Set default charset
AddDefaultCharset UTF-8

# Passenger WSGI Configuration
# IMPORTANT: App is in /home/USERNAME/msmc (NOT public_html)
PassengerPython /home/CPANEL_USERNAME/virtualenv/msmc/3.11/bin/python
PassengerAppRoot /home/CPANEL_USERNAME/msmc
PassengerAppType wsgi
PassengerStartupFile passenger_wsgi.py
